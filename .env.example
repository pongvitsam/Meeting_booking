# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit .env)
# path ของไฟล์ฐานข้อมูล (relative กับโฟลเดอร์ prisma/) บน server แนะนำ absolute เช่น file:D:/data/meeting_booking.db?connection_limit=1
DATABASE_URL="file:./meeting_booking.db?connection_limit=1"
ADMIN_PASSWORD="change-me"
# สุ่มสตริงยาว ๆ อย่างน้อย 32 ตัวอักษร ใช้เซ็น cookie ของแอดมิน
SESSION_SECRET="change-me-to-a-long-random-string-32chars+"
